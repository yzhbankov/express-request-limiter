{
  "name": "express-request-limiter",
  "version": "1.0.0",
  "description": "Super light, super fast concurrency limiter middleware for Express 5/4, Connect and Node.js http. Limit concurrent in-flight requests globally, per route or per user/IP, queue or reject with 429. Zero dependencies, 20 kB, ~4x less overhead than express-rate-limit, 100% test coverage, TypeScript.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "llms.txt",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:express4": "EXPRESS_VERSION=4 vitest run",
    "test:smoke": "node test/smoke/esm.mjs && node test/smoke/cjs.cjs",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "bench": "node bench/middleware.bench.js",
    "bench:compare": "node bench/compare.bench.js",
    "check": "npm run lint && npm run typecheck && npm run build && npm run test:smoke && npm test && npm run test:express4",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yzhbankov/express-request-limiter.git"
  },
  "keywords": [
    "express",
    "express-middleware",
    "express5",
    "connect",
    "nodejs",
    "middleware",
    "concurrency",
    "concurrency-limit",
    "concurrency-limiter",
    "concurrent-requests",
    "in-flight-requests",
    "request-limiter",
    "request-limit",
    "limit-requests",
    "throttle",
    "throttling",
    "backpressure",
    "load-shedding",
    "bulkhead",
    "overload-protection",
    "rate-limit",
    "rate-limiter",
    "rate-limiting",
    "express-rate-limit",
    "429",
    "too-many-requests",
    "retry-after",
    "ratelimit-headers",
    "request-queue",
    "queue",
    "per-user-limit",
    "per-ip-limit",
    "api-protection",
    "ddos",
    "security",
    "typescript",
    "esm",
    "zero-dependencies",
    "lightweight",
    "fast",
    "performance"
  ],
  "author": "Iaroslav Zhbankov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/yzhbankov/express-request-limiter/issues"
  },
  "homepage": "https://github.com/yzhbankov/express-request-limiter#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "express": ">=4.0.0 <6"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express4": "npm:express@^4.22.3",
    "globals": "^17.13.0",
    "supertest": "^7.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
